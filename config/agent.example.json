{
  "_comment": "Optional per-repository overrides. Copy to <target repo>/.docs-agent/config.json and edit. Every key is optional; built-in defaults are shown here.",
  "docs_dir": "docs",
  "expected_repositories": null,
  "style_guide": null,
  "evidence_exclude": [
    "docs/**",
    "wiki/**",
    "**/*.md",
    "**/*.rst",
    "**/*.adoc",
    "**/README*",
    "**/CHANGELOG*",
    "**/HISTORY*"
